# ainb-reflect-memory — environment template for the shared Postgres backend.
# Copy to `.env` (git-ignored) and fill from Bitwarden. NEVER commit real values.
#   cp .env.example .env
# None of these are needed for the unit tests (`pytest -m "not integration"`).

# --- Enable the shared backend in reflect-kb (BOTH required to switch on) ---
# Trigger is REFLECT_PG_DSN ONLY (not the generic DATABASE_URL). For WRITES the
# DSN must authenticate as service_role / table owner; `authenticated` is read-only.
REFLECT_PG_DSN=
REFLECT_WORKSPACE_ID=

# --- Migrations / seed / integration tests ---
# Postgres connection string (Supabase: Project Settings -> Database).
DATABASE_URL=
# Optional separate throwaway DB for tests (preferred over DATABASE_URL by tests).
REFLECT_TEST_DATABASE_URL=

# --- Supabase (direct PostgREST/JWT client path) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS. Server/worker only; NEVER ship to a client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Transport (both DSNs above) ---
# The writer and the broker judge TLS on the open connection: a plaintext DSN
# to a remote host is refused. Set 1 only for a throwaway local cluster.
REFLECT_PG_ALLOW_INSECURE=

# --- Role provisioning (scripts/provision_roles.py, after the migrations) ---
# 0004 creates reflect_writer and reflect_broker NOLOGIN; this sets their passwords.
REFLECT_WRITER_PASSWORD=
REFLECT_BROKER_PASSWORD=

# --- Context Broker (python -m reflect_kb.broker); see README, "Context Broker" ---
# The broker's own DSN: the reflect_broker role, TLS, never the writer's DSN.
REFLECT_BROKER_PG_DSN=
REFLECT_BROKER_ISSUER=
REFLECT_BROKER_AUDIENCE=
REFLECT_BROKER_TENANT_CLAIM=workspace_id
REFLECT_BROKER_JWKS_URL=
REFLECT_BROKER_ALGORITHMS=RS256
REFLECT_BROKER_RESOLVER=git
REFLECT_BROKER_REPOS=
REFLECT_BROKER_FORGE_URL_TEMPLATE=
REFLECT_BROKER_MAX_LIMIT=50
REFLECT_BROKER_HOST=127.0.0.1
REFLECT_BROKER_PORT=8787
