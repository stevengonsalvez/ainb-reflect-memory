---
import './explainer.css';
import corpus from '../../data/recall-corpus.json';
const base = import.meta.env.BASE_URL;
const src = `${base.endsWith('/') ? base : base + '/'}js/explainers/recall-walkthrough.js`;
// "<" is escaped so the JSON can never close the script element early.
const json = JSON.stringify(corpus).replace(/</g, '\\u003c');
---

<div class="xp xp-recall not-content" id="xp-recall-walkthrough">
  <noscript><p class="xp-noscript">This walkthrough needs JavaScript. The stage list and constants are documented below the widget.</p></noscript>
</div>
<script id="xp-recall-corpus" type="application/json" set:html={json} is:inline></script>
<script is:inline type="module" src={src}></script>
